{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iperf3 GUI Test Tool",
  "version": "0.1.0",
  "identifier": "com.networktools.iperf3gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "iperf3 GUI Test Tool",
        "width": 1680,
        "height": 960,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "resources/": "" }
  }
}
