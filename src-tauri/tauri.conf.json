{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinkGauge",
  "version": "0.4.1",
  "identifier": "com.networktools.linkgauge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LinkGauge",
        "width": 1680,
        "height": 960,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/KISSMonX/LinkGauge/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5NzREQzIwQ0NCMENBNApSV1NrRE1zTXdrMlhETzRGODF2dThxeEUzczcwYk9QN082NTRxQlJYeGlXVkJpWW9qR0o3anN3Ywo=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
